APP_ENV=development

# Supabase project connection
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only key. Never commit a real value or expose it to the browser.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Baltic Exchange API - optional until your account is entitled and a feed is configured.
# Keep the real API key only in your local .env / server secret store.
BALTIC_EXCHANGE_API_KEY=
BALTIC_EXCHANGE_FEED_ID=
BALTIC_EXCHANGE_API_VERSION=v1.3
BALTIC_EXCHANGE_API_BASE_URL=https://api.balticexchange.com

# Explicit mapping from licensed Baltic benchmark codes to real CharterPulse location UUIDs.
# Replace the example values; do not guess or infer route UUIDs from a label.
# Example:
# BALTIC_EXCHANGE_ROUTE_MAP_JSON={"C5":{"origin_location_id":"00000000-0000-4000-8000-000000000001","destination_location_id":"00000000-0000-4000-8000-000000000002","vessel_class":"Capesize"}}
# Optional path for the last successful change-marker state; defaults to ~/.charterpulse/.
BALTIC_EXCHANGE_ROUTE_MAP_JSON=
BALTIC_EXCHANGE_STATE_FILE=
