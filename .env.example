APP_ENV=development

# Supabase project connection
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only key. Never commit a real value or expose it to the browser.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Optional backend admin allowlist. Required to edit shared port constraint records.
# Use authenticated Supabase Auth user UUIDs, comma-separated; never user-editable metadata.
ADMIN_USER_IDS=

# Frontend Supabase Auth values use the public publishable key (not the server secret).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_API_BASE_URL=https://charterpulse-ai1.onrender.com


# Baltic Exchange API - optional until the account is entitled and a feed is configured.
# Keep real credentials only in the backend secret store, never in frontend variables.
BALTIC_EXCHANGE_API_KEY=
BALTIC_EXCHANGE_FEED_ID=
BALTIC_EXCHANGE_API_VERSION=v1.3
BALTIC_EXCHANGE_API_BASE_URL=https://api.balticexchange.com
# Explicit mapping from licensed benchmark codes to real CharterPulse location UUIDs.
BALTIC_EXCHANGE_ROUTE_MAP_JSON=
# Optional file for the last successful provider change-marker state.
BALTIC_EXCHANGE_STATE_FILE=
