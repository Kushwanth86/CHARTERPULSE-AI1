from pathlib import Path
from collections import Counter
import csv
import json

ROOT = Path.cwd()
SOURCE_CSV = ROOT / "data/processed/freight_rates/tanker/tanker_week_43_full_paragraphs.csv"
OUT_DIR = ROOT / "data/processed/freight_rates/tanker"
OUT_DIR.mkdir(parents=True, exist_ok=True)

SOURCE_URL = "https://www.balticexchange.com/en/data-services/WeeklyRoundup/tanker/news/2026/tanker-report-week-43.html"
SOURCE_NAME = "Baltic Exchange Weekly Tanker Report"
REPORT_DATE = "2026-10-23"
REPORT_WEEK = "2026-W43"

# Each tuple:
