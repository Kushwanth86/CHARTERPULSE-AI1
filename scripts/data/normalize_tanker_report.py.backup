    ("TD29", "Aframax", "80,000mt crude oil Vancouver/USWC lightering", 80000, [
        ("worldscale_assessment", 911, "WS_points", "exact", -35, "exact"),
    ]),
]

with SOURCE_CSV.open("r", newline="", encoding="utf-8-sig") as f:
    paragraphs = list(csv.DictReader(f))

paragraph_for_route = {}
for paragraph in paragraphs:
    for code in paragraph["route_codes"].split(";"):
        paragraph_for_route[code] = paragraph["full_paragraph"]

rows = []
for code, vessel_class, description, cargo_mt, metrics in routes:
    if code not in paragraph_for_route:
        raise ValueError(f"No source paragraph found for {code}")

    for metric, value, unit, qualifier, change, change_qualifier in metrics:
        rows.append({
            "report_date": REPORT_DATE,
            "report_week": REPORT_WEEK,
            "source": SOURCE_NAME,
            "source_url": SOURCE_URL,
            "source_file": "tanker_report_week_43_2026.html",
            "provenance": "published_source_data",
            "review_status": "REVIEW_REQUIRED_SINGLE_WEEK",
            "route_code": code,
            "vessel_class": vessel_class,
            "route_description": description,
            "cargo_size_mt": cargo_mt,
            "metric": metric,
            "value": value,
            "unit": unit,
            "value_qualifier": qualifier,
            "weekly_change_value": change,
            "weekly_change_unit": unit,
            "weekly_change_qualifier": change_qualifier,
            "source_text": paragraph_for_route[code],
        })

fields = [
    "report_date", "report_week", "source", "source_url", "source_file",
    "provenance", "review_status", "route_code", "vessel_class",
    "route_description", "cargo_size_mt", "metric", "value", "unit",
    "value_qualifier", "weekly_change_value", "weekly_change_unit",
    "weekly_change_qualifier", "source_text",
]
out_csv = OUT_DIR / "tanker_week_43_normalized_candidates.csv"
with out_csv.open("w", newline="", encoding="utf-8-sig") as f:
    writer = csv.DictWriter(f, fieldnames=fields)
    writer.writeheader()
    writer.writerows(rows)

report = {
    "mode": "LOCAL_NORMALIZATION_ONLY",
    "supabase_writes": False,
    "report_date": REPORT_DATE,
    "report_week": REPORT_WEEK,
    "source": SOURCE_NAME,
    "route_count": len(routes),
    "metric_observation_rows": len(rows),
    "metrics": dict(Counter(r["metric"] for r in rows)),
    "vessel_classes": dict(Counter(r["vessel_class"] for r in rows)),
    "qualifiers": dict(Counter(r["value_qualifier"] for r in rows)),
    "review_status": "REVIEW_REQUIRED_SINGLE_WEEK",
    "note": (
        "Manually structured from report text. Values with qualifiers such as "
        "about, under, over, almost, and just_under are approximations. "
        "Weekly change values are kept separate from current values. "
        "Review all rows before analytical use."
    ),
    "output_file": str(out_csv),
}
(OUT_DIR / "tanker_week_43_normalization_report.json").write_text(
    json.dumps(report, indent=2), encoding="utf-8"
)
print(json.dumps(report, indent=2))
print(f"\nCandidate CSV: {out_csv}")
